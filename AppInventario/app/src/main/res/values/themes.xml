<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppInventario" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
    </style>

    <style name="AppInventarioDialogTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorAccent">@color/purple_500</item>
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppInventarioDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppInventarioDialogButton</item>
    </style>

    <style name="AppInventarioDialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/purple_500</item>
    </style>
</resources>
